@model List<ServiceLibrary.Models.Product>
@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorAlert" class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<h2>Product Overview</h2>

@if (Context.Session.GetString("Role") == "Admin")
{
    <a asp-action="Create">Add New Product</a>
}

<div class="mb-3 mt-3">
    <a asp-action="Index" asp-route-category=""
           class="btn @(string.IsNullOrEmpty(ViewBag.CurrentCategory) ? "btn-dark" : "btn-outline-dark")">
        All
    </a>

    <a asp-action="Index" asp-route-category="Pizza"
           class="btn @(ViewBag.CurrentCategory == "Pizza" ? "btn-dark" : "btn-outline-dark")">
        Pizza
    </a>

    <a asp-action="Index" asp-route-category="Burgers"
           class="btn @(ViewBag.CurrentCategory == "Burgers" ? "btn-dark" : "btn-outline-dark")">
        Burgers
    </a>

    <a asp-action="Index" asp-route-category="Fries"
           class="btn @(ViewBag.CurrentCategory == "Fries" ? "btn-dark" : "btn-outline-dark")">
        Fries
    </a>

    <a asp-action="Index" asp-route-category="Drinks"
           class="btn @(ViewBag.CurrentCategory == "Drinks" ? "btn-dark" : "btn-outline-dark")">
        Drinks
    </a>

    <a asp-action="Index" asp-route-category="Snacks"
           class="btn @(ViewBag.CurrentCategory == "Snacks" ? "btn-dark" : "btn-outline-dark")">
        Snacks
    </a>
</div>

<div class="product-list">
    @foreach (var product in Model)
    {
        <div class="product-card d-flex justify-content-between align-items-center">
    
            <div class="product-info">
                <h4>@product.Name</h4>
                <p class="price">€ @product.Price</p>
                <p>@product.Description</p>

                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-action="Edit" asp-route-id="@product.ProductID">Edit</a>
                }

                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-action="Delete" asp-route-id="@product.ProductID"
                           style="color:red; font-size:20px; float:right;">
                        <i class="bi bi-trash"></i>
                    </a>
                }

                <a asp-controller="Cart"
                       asp-action="AddProduct"
                       asp-route-productID="@product.ProductID"
                       class="btn btn-sm btn-success">
                    +
                </a>
            </div>

            <div class="product-image">
                <img src="@product.ImagePath"
                     alt="@product.Name"
                     style="width:180px; height:140px; object-fit:cover; border-radius:10px;" />
            </div>

        </div>
    }
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            var alert = document.getElementById("successAlert");
            if (alert) {
                alert.style.display = "none";
            }
        }, 3000); // 3000 ms = 3 seconden
    </script>
}