<div class="home-hero">
    <div class="hero-text">
        <span class="hero-label">Fast, Fresh & Delicious</span>
        <h1>Your favorite fast food, delivered fast.</h1>
        <p>
            Browse our selection of burgers, pizzas, fries, snacks and refreshing drinks.
            Find your favorite meal and add it to your cart in just a few clicks.
        </p>

        <a asp-controller="Product" asp-action="Index" class="btn hero-btn">
            View Menu
        </a>
    </div>
</div>

<section class="home-categories">
    <p class="section-label">Top foods</p>
    <h2>Our Categories</h2>

    <div class="category-grid">
        <div class="category-card">🍕<h4>Pizza</h4></div>
        <div class="category-card">🍔<h4>Burgers</h4></div>
        <div class="category-card">🍟<h4>Fries</h4></div>
        <div class="category-card">🥤<h4>Drinks</h4></div>
        <div class="category-card">🍗<h4>Snacks</h4></div>
    </div>

    <a asp-controller="Product" asp-action="Index" class="btn category-btn">
        Go to menu
    </a>
</section>