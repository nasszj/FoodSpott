@model ServiceLibrary.Models.Cart

<h2>Shopping Cart</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorAlert" class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model.Products == null || Model.Products.Count == 0)
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>€ @item.Price</td>
                    <td>
                        <form asp-action="UpdateQuantity" method="post">
                            <input type="hidden" name="cartProductID" value="@item.CartProductID" />

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="form-control"
                                   style="width: 80px; display: inline-block;" />

                            <button type="submit" class="btn btn-sm btn-primary">
                                Update
                            </button>
                        </form>
                    </td>
                    <td>€ @item.Subtotal</td>
                    <td>
                        <a asp-action="DeleteProduct"
                               asp-route-cartProductID="@item.CartProductID"
                               class="btn btn-sm btn-danger">
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Total: € @Model.TotalPrice</h4>
}

<a asp-controller="Product" asp-action="Index">Back to products</a>

@section Scripts {
    <script>
        setTimeout(function () {

            var successAlert = document.getElementById("successAlert");

            if (successAlert) {
                successAlert.style.display = "none";
            }

        }, 3000);
    </script>
}